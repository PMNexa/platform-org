#: platform-org/backend/platform_org/views/members.py:51
msgid "Only an owner can change who is an owner."
msgstr "Chỉ chủ sở hữu mới có thể thay đổi ai là chủ sở hữu."

#: platform-org/backend/platform_org/views/organizations.py:87

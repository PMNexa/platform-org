msgstr "Chỉ chủ sở hữu hoặc quản trị viên mới có thể thay đổi tổ chức này."

#: platform-org/backend/platform_org/views/invitations.py:68
msgid "Only an owner or admin can invite members."
msgstr "Chỉ chủ sở hữu hoặc quản trị viên mới có thể mời thành viên."

#: platform-org/backend/platform_org/views/members.py:61
msgid "Only an owner or admin can remove members."
msgstr "Chỉ chủ sở hữu hoặc quản trị viên mới có thể xóa thành viên."

